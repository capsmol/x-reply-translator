{
  "manifest_version": 3,
  "name": "X Reply Translator",
  "version": "0.1.0",
  "description": "Переводит твиты на русский и ваши ответы на английский прямо в X.",
  "homepage_url": "https://github.com/capsmol/x-reply-translator",
  "icons": {
    "16": "icons/icon16.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": ["storage"],
  "host_permissions": [
    "https://translate.googleapis.com/*",
    "https://api.openai.com/*"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": ["https://x.com/*", "https://twitter.com/*"],
      "js": ["src/content.js"],
      "css": ["src/content.css"]
    }
  ],
  "action": {
    "default_title": "X Reply Translator",
    "default_popup": "src/options.html"
  }
}
